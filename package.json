{
  "name": "plainchain",
  "version": "0.1.1",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/behrouzbk/plainchain.git"
  },
  "description": "Standalone Layer 1 crypto node engine built from native primitives (no external blockchain SDKs).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "node": "tsx src/node/main.ts",
    "wallet": "tsx src/cli/main.ts",
    "simulate": "tsx scripts/simulate.ts",
    "gen-cert": "tsx scripts/genCert.ts",
    "gen-authority": "tsx scripts/genAuthority.ts",
    "gen-anchor-key": "tsx scripts/genAnchorKey.ts",
    "testnet:check": "tsx scripts/testnetCheck.ts",
    "healthcheck": "tsx scripts/healthcheck.ts",
    "testnet:tls": "tsx scripts/testnetTls.ts",
    "genesis": "tsx scripts/genesis.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "level": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
